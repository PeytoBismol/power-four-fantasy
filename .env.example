# Copy to .env and fill in. Never commit .env.
# Free CFBD key: https://collegefootballdata.com/key (no credit card)
CFBD_API_KEY=

# Season to load. The app plays this season.
SEASON=2026

# Port and database file
PORT=8080
DB_PATH=./data/power-four.sqlite

# Required to advance the season week from the admin endpoint or CLI
ADMIN_TOKEN=change-me

# Set to 1 to let ingest move the league week forward when a week is fully final
AUTO_ADVANCE=1

# Scheduled stats refresh while the server runs. Hours between runs.
# Default is 12 when CFBD_API_KEY is set, otherwise off. 0 turns it off.
# Each run re-reads rosters and box scores from CFBD. The log prints the request count per run,
# so raise the hours if you are close to your plan's limit.
# INGEST_HOURS=12

# Automatic database backups. Hours between backups. Default 24. 0 turns them off.
# BACKUP_HOURS=24

# Where backups are written. Default: a backups folder next to the database.
# BACKUP_DIR=./data/backups

# How many backups to keep before the oldest are deleted. Default 14.
# BACKUP_KEEP=14

# Live scores: while games are on, refresh the week in play every this many minutes.
# Default 10 with a key, otherwise off. 0 turns it off. The smallest allowed value is 5.
# Each refresh is about two CFBD requests.
# LIVE_SCORE_MINUTES=10

# Support address shown on the sign-in page and the Help card. Unset means no address is shown.
# SUPPORT_EMAIL=support@example.com

# Set to 1 only when the site is served over HTTPS, so the session cookie is marked Secure
# COOKIE_SECURE=1
